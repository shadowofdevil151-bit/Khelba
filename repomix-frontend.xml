<file path="frontend/features/academy/pages/ChapterQuestionsPage.jsx">
"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { useParams } from "next/navigation";
import { ArrowLeft, BookOpenCheck } from "lucide-react";
import LoadingState from "@/components/LoadingState";
import RequestErrorState from "@/components/RequestErrorState";
import { McqOptionBody, McqPrompt } from "@/features/academy/components/McqQuestionContent";
import { formatBanglaNumber } from "@/lib/formatBanglaNumber";
import { api } from "@/lib/api";
import { subjectByCode, subjectCodeForPaper } from "@/lib/subjects";

const keys = ["ক", "খ", "গ", "ঘ"];

export default function ChapterQuestionsPage() {
    const { subject, chapter } = useParams();
    const info = subjectByCode(subject);
    const chapterPosition = info?.chapterNumbers?.indexOf(Number(chapter));
    const chapterTitle = chapterPosition >= 0 ? info.chapters[chapterPosition] : "অধ্যায়ের সব প্রশ্ন";
    const [questions, setQuestions] = useState([]);
    const [loading, setLoading] = useState(true);
    const [error, setError] = useState("");
    const [loadedCount, setLoadedCount] = useState(0);

    const loadQuestions = async (signal) => {
        const params = new URLSearchParams(window.location.search);
        const requestedSubjectCode = subjectCodeForPaper(subject, params.get("paper"));
        let cursor = null;
        const seenCursors = new Set();
        const allQuestions = [];
        setLoading(true);
        setError("");
        setLoadedCount(0);
        try {
            while (true) {
                const pageParams = new URLSearchParams({
                    subject_code: requestedSubjectCode,
                    chapter: String(chapter),
                    limit: "50"
                });
                if (cursor) pageParams.set("cursor", cursor);
                const body = await api(`/academic/chapter-questions?${pageParams}`, { signal });
                if (signal?.aborted) return;
                const page = body.data?.questions;
                if (!Array.isArray(page)) {
                    throw new Error("প্রশ্নের তালিকা সঠিকভাবে পাওয়া যায়নি।");
                }
                allQuestions.push(...page);
                setLoadedCount(allQuestions.length);
                if (typeof body.data.has_more !== "boolean") {
                    if (body.data.total_questions === page.length) break;
                    throw new Error("প্রশ্নের তালিকা সঠিকভাবে পাওয়া যায়নি।");
                }
                if (!body.data.has_more) break;
                const nextCursor = body.data.next_cursor;
                if (!nextCursor || seenCursors.has(nextCursor) || page.length === 0) {
                    throw new Error("প্রশ্নগুলো সম্পূর্ণভাবে লোড করা যায়নি। আবার চেষ্টা করুন।");
                }
                seenCursors.add(nextCursor);
                cursor = nextCursor;
            }
            setQuestions(allQuestions);
        } catch (requestError) {
            if (requestError.name !== "AbortError") {
                console.error("Could not load all chapter questions.", requestError);
                setError(true);
            }
        } finally {
            if (!signal?.aborted) setLoading(false);
        }
    };

    useEffect(() => {
        const controller = new AbortController();
        loadQuestions(controller.signal);
        return () => controller.abort();
    }, [subject, chapter]);

    return <div className="mx-auto max-w-5xl">
        <header className="mb-6 flex flex-col gap-5 border-b border-white/10 pb-5 sm:flex-row sm:items-end sm:justify-between">
            <div className="min-w-0">
                <p className="text-xs font-medium text-zinc-500">{info?.shortName || subject} · সব প্রশ্ন</p>
                <div className="mt-2 flex flex-wrap items-center gap-3">
                    <span className="bangla-digits rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-sm font-semibold text-sky-400">অধ্যায় {formatBanglaNumber(chapter)}</span>
                    <h1 className="text-2xl font-bold tracking-tight text-white md:text-3xl">{chapterTitle}</h1>
                </div>
            </div>
            <div className="flex items-center gap-3">
                {!loading && !error && <span className="bangla-digits text-xs text-zinc-400">{formatBanglaNumber(questions.length)}টি প্রশ্ন</span>}
                <Link href={`/academy/${subject}`} className="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3.5 py-2 text-xs text-zinc-300 transition-colors hover:bg-white/10"><ArrowLeft size={14}/> ফিরে যান</Link>
            </div>
        </header>
        {loading ? <LoadingState title="অধ্যায়ের প্রশ্ন সাজানো হচ্ছে" detail={`${formatBanglaNumber(loadedCount)}টি প্রশ্ন প্রস্তুত · শেষ হলে সবগুলো একসঙ্গে দেখাবে`}/> : error
            ? <RequestErrorState title="প্রশ্নগুলো লোড করা যায়নি" detail="সংযোগে সাময়িক সমস্যা হয়েছে। আবার চেষ্টা করলে পুরো অধ্যায়ের প্রশ্ন একসঙ্গে দেখানো হবে।" onRetry={() => loadQuestions()}/>
            : questions.length === 0
                ? <div className="rounded-2xl border border-white/10 bg-[#14161b] p-10 text-center text-zinc-400">এই অধ্যায়ে কোনো প্রশ্ন পাওয়া যায়নি।</div>
                : <div className="space-y-4">{questions.map((question, index) => <article key={question._id} className="rounded-2xl border border-white/10 bg-[#14161b] p-5 shadow-xl sm:p-6">
                    <div className="mb-4 flex items-center justify-between gap-3">
                        <span className="bangla-digits grid h-7 w-7 shrink-0 place-items-center rounded-lg border border-sky-500/30 bg-sky-500/15 text-xs font-bold text-sky-400">{formatBanglaNumber(index + 1)}</span>
                        <span className="bangla-digits rounded-md border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-zinc-400">{question.board || "প্রশ্ন"}{question.year ? ` ${formatBanglaNumber(question.year)}` : ""}</span>
                    </div>
                    <div className="mb-5"><McqPrompt question={question}/></div>
                    <div className="grid grid-cols-1 gap-3 md:grid-cols-2">{keys.map((key, optionIndex) => {
                        if (question.options?.[optionIndex] === undefined) return null;
                        const correct = question.answer === key;
                        return <div key={key} className={`flex min-w-0 items-center gap-3 rounded-xl border p-3.5 ${correct ? "border-emerald-500/50 bg-emerald-500/10 text-emerald-100" : "border-white/10 bg-[#191c23] text-zinc-200"}`}>
                            <McqOptionBody value={question.options[optionIndex]} label={key} selected={correct} status={correct ? "correct" : undefined}/>
                        </div>;
                    })}</div>
                </article>)}
                <div className="flex items-center justify-center gap-2 py-4 text-sm text-emerald-300"><BookOpenCheck size={17}/> পড়ার জন্য—কোনো উত্তর জমা হয় না</div>
                </div>}
    </div>;
}
</file>

<file path="frontend/features/academy/pages/PracticePage.jsx">
"use client";

import Link from "next/link";
import { useEffect, useMemo, useRef, useState } from "react";
import { useParams } from "next/navigation";
import { ArrowLeft } from "lucide-react";
import { api } from "@/lib/api";
import { subjectByCode, subjectCodeForPaper } from "@/lib/subjects";
import { formatBanglaNumber } from "@/lib/formatBanglaNumber";
import { McqOptionBody, McqPrompt } from "@/features/academy/components/McqQuestionContent";
import LoadingState from "@/components/LoadingState";

const keys = ["ক", "খ", "গ", "ঘ"];
const batchSizes = [5, 10, 20, 50];
const shuffle = (items) => {
    const shuffled = [...items];
    for (let index = shuffled.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
    }
    return shuffled;
};

export default function Practice() {
    const { subject, chapter } = useParams();
    const routeInfo = subjectByCode(subject);
    const [subjectCode, setSubjectCode] = useState(routeInfo?.code || subject);
    const info = subjectByCode(subjectCode);
    const chapterPosition = info?.chapterNumbers?.indexOf(Number(chapter));
    const chapterTitle = chapterPosition >= 0 ? info.chapters[chapterPosition] : undefined;
    const [subjectHref, setSubjectHref] = useState(`/academy/${subject}`);
    const [questions, setQuestions] = useState([]);
    const [answers, setAnswers] = useState({});
    const [result, setResult] = useState(null);
    const [size, setSize] = useState(10);
    const [loading, setLoading] = useState(true);
    const [submitting, setSubmitting] = useState(false);
    const [error, setError] = useState("");
    const recentQuestionIds = useRef([]);

    const load = async (requestedLimit, signal, requestedSubjectCode = subjectCode) => {
        setLoading(true);
        setError("");
        setQuestions([]);
        try {
            const limit = batchSizes.includes(requestedLimit) ? requestedLimit : 10;
            const params = new URLSearchParams({
                subject_code: requestedSubjectCode,
                chapter: String(chapter),
                limit: String(limit),
                randomize: "true"
            });
            if (recentQuestionIds.current.length) params.set("exclude_ids", recentQuestionIds.current.join(","));
            const body = await api(`/academic/remaining-questions?${params}`, { signal });
            if (signal?.aborted) return;
            const nextQuestions = shuffle(body.data.questions || []);
            recentQuestionIds.current = nextQuestions.map((question) => question._id);
            setQuestions(nextQuestions);
        } catch (requestError) {
            if (requestError.name !== "AbortError") setError(requestError.message);
        } finally {
            if (!signal?.aborted) setLoading(false);
        }
    };

    useEffect(() => {
        const params = new URLSearchParams(window.location.search);
        const requestedSubjectCode = subjectCodeForPaper(subject, params.get("paper"));
        const requestedSize = Number(params.get("size"));
        const hasStartParam = params.has("start");
        const controller = new AbortController();
        setSubjectCode(requestedSubjectCode);
        params.delete("start");
        params.delete("size");
        const subjectQuery = params.toString();
        setSubjectHref(`/academy/${subject}${subjectQuery ? `?${subjectQuery}` : ""}`);
        const selectedSize = batchSizes.includes(requestedSize) ? requestedSize : 10;
        setSize(selectedSize);
        setAnswers({});
        setResult(null);
        recentQuestionIds.current = [];
        if (hasStartParam) {
            const cleanUrl = new URL(window.location.href);
            cleanUrl.searchParams.delete("start");
            window.history.replaceState(window.history.state, "", `${cleanUrl.pathname}${cleanUrl.search}${cleanUrl.hash}`);
        }
        load(selectedSize, controller.signal, requestedSubjectCode);
        return () => controller.abort();
    }, [subject, chapter]);

    const current = useMemo(() => questions.slice(0, size), [questions, size]);
    const answeredCount = current.filter((question) => answers[question._id]).length;
    const resultById = useMemo(() => new Map((result?.results || []).map((item) => [item.question_id, item])), [result]);
    const correctCount = result?.results.filter((item) => item.correct).length || 0;
    const wrongCount = (result?.results.length || 0) - correctCount;
    const accuracy = result?.results.length ? Math.round((correctCount / result.results.length) * 100) : 0;

    const submit = async () => {
        if (submitting || answeredCount !== current.length || current.length === 0) return;
        window.scrollTo({ top: 0, behavior: "smooth" });
        setSubmitting(true);
        setError("");
        try {
            const submittedAnswers = { ...answers };
            const body = await api("/academic/submit-answer", {
                method: "POST",
                body: JSON.stringify({
                    subject_code: subjectCode,
                    chapter: Number(chapter),
                    answers: current.map((question) => ({
                        question_id: question._id,
                        answer: submittedAnswers[question._id]
                    }))
                })
            });
            setResult({ ...body.data, selectedAnswers: submittedAnswers });
        } catch (requestError) {
            setError(requestError.message);
        } finally {
            setSubmitting(false);
        }
    };

    return <div className="mx-auto max-w-5xl">
        <header className="mb-6 flex flex-col gap-5 border-b border-white/10 pb-5 lg:flex-row lg:items-end lg:justify-between">
            <div className="min-w-0">
                <p className="text-xs font-medium text-zinc-500">{info?.shortName || subject}</p>
                <div className="mt-2 flex flex-wrap items-center gap-3">
                    <span className="bangla-digits rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-sm font-semibold text-sky-400">অধ্যায় {formatBanglaNumber(chapter)}</span>
                    <h1 className="text-2xl font-bold tracking-tight text-white md:text-3xl">{chapterTitle || "অধ্যায়ের অনুশীলন"}</h1>
                </div>
            </div>
            <div className="flex flex-wrap items-center gap-2 lg:justify-end">
                <p className="bangla-digits mr-1 text-xs text-zinc-400">মোট {formatBanglaNumber(current.length)}টি · উত্তর দিয়েছেন {formatBanglaNumber(answeredCount)}/{formatBanglaNumber(current.length)}টি</p>
                <Link href={`/academy/${subjectCode}/${chapter}/wrong`} className="inline-flex items-center rounded-lg border border-rose-500/25 bg-rose-500/10 px-3.5 py-2 text-xs text-rose-400 transition-colors hover:bg-rose-500/20">ভুল উত্তর অনুশীলন</Link>
                <Link href={subjectHref} className="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3.5 py-2 text-xs text-zinc-300 transition-colors hover:bg-white/10"><ArrowLeft size={14}/> ফিরে যান</Link>
            </div>
        </header>
        {result && <section aria-label="এই অনুশীলনের ফলাফল" className="mb-6 grid gap-3 rounded-2xl border border-white/10 border-t-2 border-t-sky-500/50 bg-[#14161b] p-4 shadow-xl sm:grid-cols-3 sm:p-5">
            <div className="rounded-xl border border-emerald-500/20 bg-emerald-500/[.07] p-4">
                <div className="bangla-digits text-2xl font-bold text-emerald-300">{formatBanglaNumber(correctCount)}</div>
                <div className="mt-1 text-xs text-zinc-400">সঠিক উত্তর</div>
            </div>
            <div className="rounded-xl border border-rose-500/20 bg-rose-500/[.07] p-4">
                <div className="bangla-digits text-2xl font-bold text-rose-300">{formatBanglaNumber(wrongCount)}</div>
                <div className="mt-1 text-xs text-zinc-400">ভুল উত্তর</div>
            </div>
            <div className="rounded-xl border border-sky-500/20 bg-sky-500/[.07] p-4">
                <div className="bangla-digits text-2xl font-bold text-sky-300">{formatBanglaNumber(accuracy)}%</div>
                <div className="mt-1 text-xs text-zinc-400">সঠিক উত্তরের হার · {formatBanglaNumber(result.results.length)}টি প্রশ্ন</div>
            </div>
        </section>}
        {loading ? <LoadingState title="প্রশ্ন প্রস্তুত হচ্ছে" detail="আপনার জন্য নতুন প্রশ্ন সাজাচ্ছি…"/> : error ? <div role="alert" className="panel flex flex-col items-center gap-4 p-8 text-center"><p className="text-rose-300">{error}</p><button type="button" onClick={() => load(size)} className="rounded-xl bg-blue-700 px-4 py-2.5 font-medium text-white transition hover:bg-blue-600">আবার চেষ্টা করুন</button></div> : <>
            <div className="space-y-4">{current.map((question, index) => <article key={question._id} className="rounded-2xl border border-white/10 bg-[#14161b] p-5 shadow-xl sm:p-6">
                <div className="mb-4 flex items-center justify-between gap-3">
                    <span className="bangla-digits grid h-7 w-7 shrink-0 place-items-center rounded-lg border border-sky-500/30 bg-sky-500/15 text-xs font-bold text-sky-400">{formatBanglaNumber(index + 1)}</span>
                    <span className="bangla-digits rounded-md border border-white/10 bg-white/5 px-2.5 py-1 text-xs text-zinc-400">{question.board || "প্রশ্ন"}{question.year ? ` ${formatBanglaNumber(question.year)}` : ""}</span>
                </div>
                <div className="mb-5"><McqPrompt question={question}/></div>
                <div className="grid grid-cols-1 gap-3 md:grid-cols-2">{keys.map((key, optionIndex) => {
                    if (question.options?.[optionIndex] === undefined) return null;
                    const selected = answers[question._id] === key;
                    const outcome = resultById.get(question._id);
                    const isCorrect = Boolean(outcome) && outcome.correct_answer === key;
                    const isWrongSelection = Boolean(outcome) && selected && !outcome.correct;
                    const isHighlighted = selected || isCorrect;
                    const status = isCorrect ? "correct" : isWrongSelection ? "incorrect" : "selected";
                    const optionClass = isCorrect
                        ? "border-emerald-500/50 bg-emerald-500/10 text-emerald-100"
                        : isWrongSelection
                            ? "border-rose-500/50 bg-rose-500/10 text-rose-100"
                            : selected
                                ? "border-sky-500/50 bg-sky-500/[.12] text-white"
                                : "border-white/10 bg-[#191c23] text-zinc-200 hover:border-white/25 hover:bg-[#1f232c]";
                    return <button key={key} type="button" aria-pressed={selected} disabled={Boolean(outcome)} onClick={() => setAnswers((old) => ({ ...old, [question._id]: key }))} className={`flex min-w-0 items-center gap-3 rounded-xl border p-3.5 text-left transition-colors duration-75 disabled:cursor-default ${optionClass}`}><McqOptionBody value={question.options[optionIndex]} label={key} selected={isHighlighted} status={status}/></button>;
                })}</div>
            </article>)}
            {!loading && !current.length && <div className="panel p-10 text-center"><h2 className="font-serif text-2xl">এই অধ্যায়ের অনুশীলন সম্পন্ন।</h2><p className="muted mt-2">ফলাফল দেখুন অথবা ভুল হওয়া প্রশ্নগুলো আবার অনুশীলন করুন।</p></div>}
            {current.length > 0 && (result
                ? <button type="button" className="bangla-digits primary mt-6 w-full md:w-auto" onClick={() => { setResult(null); setAnswers({}); load(size); }}>আরেকটি ব্যাচ শুরু করুন</button>
                : <button className="bangla-digits primary mt-6 w-full md:w-auto" onClick={submit} disabled={submitting || answeredCount !== current.length}>{submitting ? "ফলাফল সংরক্ষণ হচ্ছে…" : answeredCount === current.length ? `${formatBanglaNumber(current.length)}টি উত্তর জমা দিন` : <>সব প্রশ্নের উত্তর দিন ({formatBanglaNumber(answeredCount)}/{formatBanglaNumber(current.length)})</>}</button>)}</div>
            </>}
    </div>;
}
</file>

<file path="frontend/features/academy/pages/SubjectPage.jsx">
"use client";

import Link from "next/link";
import { useEffect, useMemo, useState } from "react";
import { useParams, useRouter } from "next/navigation";
import { ArrowLeft, ArrowRight, RotateCcw, X } from "lucide-react";
import { academyPapersForSubject } from "@/lib/subjects";
import { useAuth } from "@/hooks/useAuth";
import SubjectArtwork from "@/features/academy/components/SubjectArtwork";
import { formatBanglaNumber } from "@/lib/formatBanglaNumber";
import { noteStreams } from "@/lib/notesCatalog";

const banglaSections = [
    { id: "prose", name: "গদ্য" },
    { id: "poetry", name: "কবিতা" },
    { id: "sohopath", name: "সহপাঠ" }
];

export default function SubjectPage() {
    const { subject } = useParams();
    const router = useRouter();
    const { user } = useAuth();
    const papers = useMemo(() => academyPapersForSubject(subject), [subject]);
    const profileStream = user?.profile?.education_stream || "SCIENCE";
    const [selectedPaper, setSelectedPaper] = useState(null);
    const [stream, setStream] = useState(profileStream);
    const [selectedSection, setSelectedSection] = useState("poetry");
    const [practiceChapter, setPracticeChapter] = useState(null);
    const [batchSize, setBatchSize] = useState(10);
    const routePaper = papers.find((paper) => paper.code === subject)?.paper;
    const activePaper = papers.find((paper) => paper.paper === selectedPaper)
        || papers.find((paper) => paper.paper === routePaper)
        || papers[0];

    useEffect(() => {
        const query = new URLSearchParams(window.location.search);
        const queryPaper = Number(query.get("paper"));
        const initialPaper = papers.find((paper) => paper.paper === queryPaper)
            || papers.find((paper) => paper.paper === routePaper)
            || papers[0];
        setSelectedPaper(initialPaper?.paper ?? null);
        const queryStream = query.get("stream")?.toUpperCase();
        setStream(noteStreams.find((item) => item.id === queryStream)?.id || profileStream);
        setSelectedSection("poetry");
    }, [papers, profileStream, routePaper, subject]);

    useEffect(() => {
        if (practiceChapter === null) return undefined;
        const closeOnEscape = (event) => {
            if (event.key === "Escape") setPracticeChapter(null);
        };
        window.addEventListener("keydown", closeOnEscape);
        return () => window.removeEventListener("keydown", closeOnEscape);
    }, [practiceChapter]);

    const selectPaper = (paper) => {
        setSelectedPaper(paper.paper);
        setSelectedSection("poetry");
        window.history.replaceState(null, "", `/academy/${subject}?stream=${stream.toLowerCase()}&paper=${paper.paper}`);
    };

    if (!activePaper) return <div className="panel p-10 text-center">বিষয়টি পাওয়া যায়নি।</div>;

    const returnUrl = `/academy?stream=${stream.toLowerCase()}`;
    const chapterEntries = activePaper.chapters.map((chapter, index) => ({
        chapter,
        index: activePaper.chapterNumbers[index] ?? index + 1,
        section: activePaper.chapterSections?.[index] || null
    }));
    const isBanglaFirstPaper = activePaper.shortCode === "BNG" && activePaper.paper === 1;
    const visibleChapterEntries = isBanglaFirstPaper
        ? chapterEntries.filter((entry) => entry.section === selectedSection)
        : chapterEntries;
    const selectedChapter = chapterEntries.find((entry) => entry.index === practiceChapter);
    const startPractice = () => {
        if (practiceChapter === null) return;
        router.push(`/academy/${activePaper.code}/${practiceChapter}?stream=${stream.toLowerCase()}&paper=${activePaper.paper}&size=${batchSize}`);
        setPracticeChapter(null);
    };

    return <>
        <header className={`academy-subject-card academy-subject-card-${activePaper.shortCode} group relative isolate mb-6 overflow-hidden rounded-2xl border border-white/10 border-t p-5 sm:p-7`}>
            <SubjectArtwork code={activePaper.shortCode} variant="academy"/>
            <div className="relative z-10 flex min-h-28 items-start">
                <div className="max-w-2xl">
                    <h1 className="text-3xl font-bold text-white">{activePaper.name}</h1>
                    <p className="mt-2 text-sm text-zinc-400">বিষয়ভিত্তিক অধ্যায় থেকে অনুশীলন বেছে নিন।</p>
                    <Link href={returnUrl} className="mt-4 inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3.5 py-2.5 text-sm font-medium text-zinc-100 transition-colors hover:bg-white/10"><ArrowLeft size={16}/> Back</Link>
                </div>
            </div>
        </header>
        {papers.length > 1 && <section aria-label="পত্র বেছে নিন" className="mb-6 grid grid-cols-2 gap-4">
            {papers.map((paper) => {
                const active = paper.paper === activePaper.paper;
                const paperLabel = paper.paper === 1 ? "১ম" : "২য়";
                return <button key={paper.code} type="button" aria-pressed={active} onClick={() => selectPaper(paper)}
                    className={`flex min-h-[76px] items-center gap-3 rounded-xl border px-4 py-3 text-left transition-colors ${active ? "border-cyan-500/60 bg-[#161b22] text-white shadow-[0_0_20px_rgba(6,182,212,0.12)]" : "border-white/10 bg-[#14161b] text-zinc-400 hover:border-white/20"}`}>
                    <span className={`grid h-10 w-10 shrink-0 place-items-center rounded-lg text-sm font-bold ${active ? "bg-cyan-500/20 text-cyan-400" : "bg-white/5 text-zinc-500"}`}>{paperLabel}</span>
                    <span className="font-semibold">{paperLabel} পত্র</span>
                </button>;
            })}
        </section>}
        {isBanglaFirstPaper && <section aria-label="বাংলা প্রথম পত্রের বিভাগ" className="mb-6 flex flex-wrap gap-2">
            {banglaSections.map(({ id, name }) => {
                const active = selectedSection === id;
                return <button key={id} type="button" aria-pressed={active} onClick={() => setSelectedSection(id)}
                    className={`rounded-full border px-4 py-2 text-sm font-medium transition ${active ? "border-rose-200/35 bg-rose-200/[.12] text-rose-50" : "border-white/10 text-white/65 hover:border-white/20 hover:text-white"}`}>
                    {name}
                </button>;
            })}
        </section>}
        <section className="mb-7 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-rose-500/25 bg-[#14161b] p-4">
            <div className="flex min-w-0 items-center gap-3">
                <span className="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-rose-500/20 bg-rose-500/10 text-rose-400"><RotateCcw size={19}/></span>
                <div><h2 className="font-semibold text-zinc-100">ভুল উত্তরের অনুশীলন</h2><p className="mt-1 text-sm text-zinc-500">আগের ভুলগুলো আবার দেখে নাও—এবার ঠিক করে ফেলো।</p></div>
            </div>
            <Link href="#chapters" className="inline-flex shrink-0 items-center gap-2 rounded-lg border border-rose-500/30 bg-rose-500/15 px-3.5 py-2 text-sm font-medium text-rose-400 transition-colors hover:bg-rose-500/25">অধ্যায় বেছে নিন <ArrowRight size={15}/></Link>
        </section>
        <div id="chapters" className="mb-4 flex items-center justify-between gap-3">
            <div><div className="eyebrow">পাঠ্যক্রম</div><h2 className="mt-1 font-serif text-2xl text-white">সব অধ্যায়</h2></div>
            <span className="bangla-digits rounded-full bg-white/5 px-2.5 py-1 text-xs text-zinc-400">{formatBanglaNumber(visibleChapterEntries.length)}টি অধ্যায়</span>
        </div>
        <div className="grid gap-3">{visibleChapterEntries.map(({ chapter, index }, visibleIndex) => {
            const displayIndex = isBanglaFirstPaper ? visibleIndex + 1 : index;
            return <article key={`${activePaper.code}-${index}`} className="flex flex-col gap-4 rounded-xl border border-white/10 bg-[#14161b] px-5 py-4 transition-all hover:border-white/20 hover:bg-[#191c23] sm:flex-row sm:items-center">
            <span className="bangla-digits grid h-11 w-11 shrink-0 place-items-center rounded-full border border-white/10 bg-white/5 text-sm font-medium text-zinc-300">{formatBanglaNumber(String(displayIndex).padStart(2, "0"))}</span>
            <div className="min-w-0 flex-1">
                <h3 className="text-base font-medium leading-6 text-zinc-100">{chapter}</h3>
                <p className="mt-1 text-xs text-zinc-500">অধ্যায় {formatBanglaNumber(displayIndex)} · MCQ অনুশীলন</p>
            </div>
            <div className="grid shrink-0 grid-cols-1 gap-2 sm:flex">
                <button type="button" onClick={() => setPracticeChapter(index)} className="inline-flex items-center justify-center gap-1.5 rounded-lg bg-blue-700 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-600">অনুশীলন <ArrowRight size={15}/></button>
                <Link href={`/academy/${activePaper.code}/${index}/all?stream=${stream.toLowerCase()}&paper=${activePaper.paper}`} className="inline-flex items-center justify-center rounded-lg border border-sky-500/30 bg-sky-500/10 px-3.5 py-2 text-sm font-medium text-sky-300 transition-colors hover:bg-sky-500/20">সব প্রশ্ন</Link>
                <Link href={`/academy/${activePaper.code}/${index}/wrong`} className="inline-flex items-center justify-center rounded-lg border border-rose-500/30 bg-rose-500/10 px-3.5 py-2 text-sm font-medium text-rose-400 transition-colors hover:bg-rose-500/20">ভুল উত্তর</Link>
            </div>
        </article>;
        })}</div>
        {practiceChapter !== null && <div role="presentation" onMouseDown={(event) => {
            if (event.target === event.currentTarget) setPracticeChapter(null);
        }} className="fixed inset-0 z-50 grid place-items-center overflow-y-auto bg-black/70 p-4 backdrop-blur-sm">
            <section role="dialog" aria-modal="true" aria-labelledby="practice-modal-title" className="w-full max-w-lg rounded-2xl border border-white/10 border-t-2 border-t-sky-500/60 bg-[#14161b] p-6 shadow-2xl sm:p-7">
                <div className="flex items-start justify-between gap-4">
                    <div><p className="text-xs font-medium uppercase tracking-[.18em] text-sky-300">অনুশীলন প্রস্তুতি</p><h2 id="practice-modal-title" className="mt-2 text-xl font-bold text-white">{selectedChapter?.chapter || "অধ্যায়"}</h2><p className="mt-1 text-sm text-zinc-400">কয়টি প্রশ্ন দিয়ে শুরু করবেন?</p></div>
                    <button type="button" onClick={() => setPracticeChapter(null)} aria-label="বন্ধ করুন" className="rounded-lg border border-white/10 bg-white/5 p-2 text-zinc-300 transition hover:bg-white/10"><X size={18}/></button>
                </div>
                <div className="mt-6 grid grid-cols-4 gap-3">{[5, 10, 20, 50].map((value) => <button key={value} type="button" aria-pressed={batchSize === value} onClick={() => setBatchSize(value)} className={`relative rounded-xl py-3 transition-all ${batchSize === value ? "border-2 border-sky-400 bg-sky-500/15 text-white shadow-[0_0_20px_rgba(56,189,248,0.18)]" : "border border-white/10 bg-[#191c23] text-zinc-300 hover:border-white/25"}`}>
                    {batchSize === value && <span className="absolute right-2 top-2 h-2 w-2 rounded-full bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,.9)]"/>}
                    <span className="bangla-digits block text-xl font-bold">{formatBanglaNumber(value)}</span><span className="mt-1 block text-xs text-zinc-400">টি প্রশ্ন</span>
                </button>)}</div>
                <button type="button" onClick={startPractice} className="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-blue-700 py-3.5 font-semibold text-white shadow-lg shadow-blue-900/30 transition-all hover:bg-blue-600">অনুশীলন শুরু করুন <ArrowRight size={17}/></button>
            </section>
        </div>}
    </>;
}
