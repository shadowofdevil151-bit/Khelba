end
local count = redis.call('INCR', KEYS[3])
if count == 1 then redis.call('EXPIRE', KEYS[3], ARGV[3]) end
if count > tonumber(ARGV[4]) then return {'RATE_LIMIT', tostring(redis.call('TTL', KEYS[3]))} end
local time = redis.call('TIME')
