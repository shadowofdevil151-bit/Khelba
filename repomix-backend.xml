<file path="src/middlewares/error.middleware.js">
import { ZodError } from "zod";

import { ApiResponse } from "../utils/ApiResponse.js";
import { AppLogger } from "../utils/logger.js";

import { serverConfig } from "../config/env.js";

export const globalErrorHandler = async (error, req, res, next) => {
  if (res.headersSent) {
    return next(error);
  }

  let statusCode = error?.statusCode || error?.status || 500;
  let message = error?.message || "Internal Server Error";
  let structuredErrors;

  const errorName = error?.name;
  const errorCode = error?.code;
  const errorMessage = error?.message;
  const isRedisUnavailable =
    errorCode === "ECONNREFUSED" ||
    errorCode === "ETIMEDOUT" ||
    errorCode === "NR_CLOSED" ||
    /stream isn't writeable|redis.*connection.*closed|max retries per request/i.test(
      errorMessage || ""
    );

  if (isRedisUnavailable) {
    statusCode = 503;
    message = "A required service is temporarily unavailable. Please try again.";
  }

  else if (errorName === "VersionError") {
    statusCode = 409;
    message =
      "Resource state conflict encountered. The data was modified by a parallel process.";
  }

  else if (
    errorMessage === "Open" ||
    errorCode === "E_CIRCUIT_OPEN"
  ) {
    statusCode = 503;
    message =
      "Database resources are currently overloaded. Fast-failing via Circuit Breaker.";
  }

  else if (error instanceof ZodError) {
    statusCode = 400;
    message = "Validation Error";

    structuredErrors = {};

    for (const issue of error.issues) {
      structuredErrors[issue.path.join(".")] = issue.message;
    }
  }

  else if (errorCode === 11000) {
    statusCode = 400;

    const field =
      Object.keys(error.keyValue || {})[0] || "field";

    message = `An account/document with this ${field} already exists.`;

    structuredErrors = {
      [field]: `This ${field} is already in use.`
    };
  }

  else if (errorName === "CastError") {
    statusCode = 400;
    message = `Invalid format for resource identifier: ${error.value}`;
  }

  else if (
    error instanceof SyntaxError &&
    error.status === 400 &&
    "body" in error
  ) {
    statusCode = 400;
    message = "Malformed JSON payload format.";
  }

  else if (errorMessage?.toLowerCase().includes("jose")) {
    statusCode = 401;

    message = errorMessage.includes("expired")
      ? "Session expired. Please log in again."
      : "Invalid access token credentials.";
  }

  if (
    typeof statusCode !== "number" ||
    statusCode < 100 ||
    statusCode > 599
  ) {
    statusCode = 500;
  }

  const telemetryContext = {
    statusCode,
    path: req.path.replace(/\/(reset-password|verify-email)\/[^/]+/g, "/$1/[REDACTED]"),
    method: req.method,
    clientIp:
      req.ip || req.socket.remoteAddress,
    userId: req.user?._id,
    validationFields: structuredErrors
  };

  if (
    Array.isArray(error?.errors) &&
    error.errors.length > 0
  ) {
    telemetryContext.subErrors = error.errors.map(
      (err) => ({
        message: err.message,
        path: err.path
      })
    );
  }

  const severity = String(
    error?.severity ||
    (statusCode >= 500 ? "error" : "info")
  ).toLowerCase();

  switch (severity) {
    case "fatal":
      AppLogger.fatal(
        "Catastrophic system block triggered.",
        error,
        telemetryContext
      );
      break;

    case "error":
      AppLogger.error(
        "Unhandled server execution failure.",
        error,
        telemetryContext
      );
      break;

    case "warn":
      AppLogger.warn(
        "Operational warning encountered.",
        telemetryContext
      );
      break;

    default:
      AppLogger.info(
        "Operational request rejected.",
        telemetryContext
      );
  }

  return res.status(statusCode).json(
    new ApiResponse(
      statusCode,
      {
        success: false,
        status: statusCode,
        message,
        errors:
          structuredErrors ||
          (error?.errors?.length
            ? error.errors
            : undefined),
        stack:
          serverConfig.env === "development"
            ? error.stack
            : undefined
      },
      message
    )
  );
};
</file>

<file path="src/middlewares/upload.middleware.js">
import multer from 'multer';
import cloudinary from "../config/cloudinary.js";

const storage = multer.memoryStorage();

const upload = multer({
    storage: storage,
    limits: {
        fileSize: 5 * 1024 * 1024, // Strictly under 5MB
    },
    fileFilter: (req, file, cb) => {
        if (file.mimetype.startsWith('image/')) {
            cb(null, true);
        } else {
            cb(new Error('Only image files are allowed!'), false);
        }
    },
}).single('avatar');

const profileUpload = multer({
    storage,
    limits: { fileSize: 5 * 1024 * 1024 },
    fileFilter: (req, file, cb) => cb(null, file.mimetype.startsWith("image/"))
}).single("avatar");

export const handleAvatarUpload = (req, res, next) => {
    profileUpload(req, res, async (err) => {
        if (err) return res.status(400).json({ success: false, message: err.code === "LIMIT_FILE_SIZE" ? "Image must be under 5MB." : "Only image files are allowed." });
        if (!req.file) return next();
        try {
            const result = await new Promise((resolve, reject) => {
                const stream = cloudinary.uploader.upload_stream({ folder: "user_profiles", resource_type: "image" },
                    (error, value) => error ? reject(error) : resolve(value));
                stream.end(req.file.buffer);
            });
            req.avatar = { publicId: result.public_id, url: result.secure_url.replace('/upload/', '/upload/f_auto,q_auto/'), mimeType: req.file.mimetype };
            return next();
        } catch { return res.status(502).json({ success: false, message: "Avatar upload failed." }); }
    });
};

export const handleImageUpload = (req, res, next) => {
    upload(req, res, async (err) => {
        if (err) {
            if (err.code === 'LIMIT_FILE_SIZE') {
                return res.status(400).json({ success: false, message: 'Image must be under 5MB.' });
            }
            return res.status(400).json({ success: false, message: err.message });
        }

        // STRICT REQUIREMENT: Reject the request if no file is present
        if (!req.file) {
            return res.status(400).json({
                success: false,
                message: 'Registration failed: Profile image upload is strictly required.'
            });
        }

        try {
            const mimeType = req.file.mimetype;

            const uploadStream = cloudinary.uploader.upload_stream(
                {
                    folder: 'user_profiles',
                    resource_type: 'image',
                },
                (error, result) => {
                    if (error) {
                        return res.status(500).json({ success: false, message: 'Cloudinary upload failed.', error });
                    }

                    // Passes exactly what your auth.controller.js expects
                    req.avatar = {
                        publicId: result.public_id,
                        url: result.secure_url.replace('/upload/', '/upload/f_auto,q_auto/'),
                        mimeType: mimeType,
                    };

                    next();
                }
            );

            uploadStream.end(req.file.buffer);

        } catch (streamError) {
            return res.status(500).json({ success: false, message: 'Server upload stream error.' });
        }
    });
};
</file>

<file path="src/middlewares/validate.middleware.js">
export const validate = (schema) => (req, res, next) => {
  const result = schema.safeParse({
    body: req.body || {},
    query: req.query || {},
    params: req.params || {},
  });

  if (!result.success) {
    return next(result.error);
  }

  req.body = { ...result.data.body };
  req.query = { ...result.data.query };
  req.params = { ...result.data.params };

  next();
};
