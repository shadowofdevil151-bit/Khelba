  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --import ./src/telemetry-preload.js server.js",
    "start:worker": "node --import ./src/telemetry-preload.js src/workers/start.js",
    "dev:api": "nodemon -L --exec \"node --import ./src/telemetry-preload.js\" server.js",
    "dev:worker": "nodemon -L --exec \"node --import ./src/telemetry-preload.js\" src/workers/start.js",
    "battle:test-client": "node dev/battle-client/server.js",
