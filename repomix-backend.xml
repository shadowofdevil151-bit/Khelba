<file path="src/workers/handlers/battle/round.handler.js">
import { randomInt } from "node:crypto";
import { mainQueue } from "../../../queues/main.queue.js";
import { redis } from "../../../config/redis.js";
import { AppLogger } from "../../../utils/logger.js";
import {
    BATTLE_ANSWER_KEYS,
    BATTLE_EVENTS,
    BATTLE_TTL_SECONDS
} from "../../../modules/battle/battle.constants.js";
import { sanitizeQuestion } from "../../../modules/battle/battle.questions.js";
import {
    ADVANCE_BATTLE_ROUND_SCRIPT,
    BATTLE_KEYS,
    SUBMIT_BATTLE_ANSWER_SCRIPT,
    TIMEOUT_BATTLE_ROUND_SCRIPT,
    redisCall
} from "../../../modules/battle/battle.redis.js";
import {
    scheduleBattleFinalization,
    scheduleBotAnswer,
    scheduleBotProactiveChat,
    scheduleNextQuestion,
    scheduleRoundTimeout
} from "../../../modules/battle/battle.jobs.js";
import { recordBattleAnswer } from "../../../modules/battle/battle.answers.js";
import { emitBattlePlayers } from "./socketEmitter.js";

const getState = async (battleId) => {
    const raw = await redis.get(BATTLE_KEYS.payload(battleId));
    if (!raw) return null;
    try {
        return JSON.parse(raw);
    } catch (error) {
        AppLogger.error("Battle worker found corrupt Redis state", error, {
            component: "battle-rounds",
            battleId
        });
        throw error;
    }
};

const removeRoundTimeout = async (battleId, questionIndex) => {
    const jobId = `battle-timeout-${battleId}-${questionIndex}`;
    const job = await mainQueue.getJob(jobId);
    if (!job) return;
    const jobState = await job.getState();
    if (["delayed", "waiting", "waiting-children"].includes(jobState)) {
        await job.remove();
    }
};

export const advanceBattleQuestion = async ({ battleId, expectedIndex } = {}) => {
    if (typeof battleId !== "string" || !Number.isInteger(expectedIndex)) {
        throw new TypeError("Next-question job payload is invalid.");
    }

    const result = await redisCall(
        ADVANCE_BATTLE_ROUND_SCRIPT,
        [BATTLE_KEYS.payload(battleId)],
        [
            String(expectedIndex),
            String(BATTLE_TTL_SECONDS.BATTLE_STATE),
            String(BATTLE_TTL_SECONDS.ROUND_TIMEOUT)
        ]
    );
    if (result[0] === "MISSING" || result[0] === "STALE" || result[0] === "NOT_ACTIVE") return;
    if (result[0] === "CORRUPT") throw new Error(`Battle ${battleId} state is corrupted.`);
    if (result[0] === "WAITING") return;
    if (result[0] === "DONE") {
        await scheduleBattleFinalization(battleId);
        return;
    }
    if (!["OK", "REPLAY"].includes(result[0])) {
        throw new Error(`Unexpected next-question result: ${result[0]}`);
    }

    const state = JSON.parse(result[1]);
    const index = state.current_index;
    const question = state.questions[index];
    if (!question) throw new Error(`Question ${index} is missing from battle ${battleId}.`);

    await removeRoundTimeout(battleId, index - 1);
    await scheduleRoundTimeout(
        battleId,
        index,
        result[0] === "REPLAY"
            ? Math.max(0, Number(result[2]))
            : BATTLE_TTL_SECONDS.ROUND_TIMEOUT * 1000
    );
    if (state.isBot) {
        const delay = randomInt(
            BATTLE_TTL_SECONDS.BOT_ANSWER_MIN_DELAY,
            BATTLE_TTL_SECONDS.BOT_ANSWER_MAX_DELAY + 1
        );
        await scheduleBotAnswer(battleId, index, delay * 1000);
        if (state.bot_can_proactively_chat && index > 0) {
            const completedRound = index - 1;
            await scheduleBotProactiveChat(
                battleId,
                `round-result-${completedRound}`,
                "round_result",
                completedRound
            ).catch((error) => {
                AppLogger.error("Could not schedule bot round-result chat", error, {
                    component: "battle-bot-chat",
                    battleId,
                    roundIndex: completedRound
                });
            });
        }
        if (state.bot_can_proactively_chat && index === 0) {
            await scheduleBotProactiveChat(battleId, "opening", "greeting").catch((error) => {
                AppLogger.error("Could not schedule bot opening chat", error, {
                    component: "battle-bot-chat",
                    battleId
                });
            });
        } else if (state.bot_can_proactively_chat && index === 4) {
            await scheduleBotProactiveChat(battleId, "mid-game", "game_state").catch((error) => {
                AppLogger.error("Could not schedule bot mid-game chat", error, {
                    component: "battle-bot-chat",
                    battleId
                });
            });
        } else if (state.bot_can_proactively_chat && index === 8) {
            await scheduleBotProactiveChat(battleId, "final-question", "close_call").catch((error) => {
                AppLogger.error("Could not schedule bot final-question chat", error, {
                    component: "battle-bot-chat",
                    battleId
                });
            });
        }
    }
    emitBattlePlayers(state, BATTLE_EVENTS.NEXT_QUESTION, {
        battleId,
        index,
        question: sanitizeQuestion(question),
        timeout_seconds: BATTLE_TTL_SECONDS.ROUND_TIMEOUT
    });
};

export const timeoutBattleRound = async ({ battleId, questionIndex } = {}) => {
    if (typeof battleId !== "string" || !Number.isInteger(questionIndex)) {
        throw new TypeError("Round-timeout job payload is invalid.");
    }
    const result = await redisCall(
        TIMEOUT_BATTLE_ROUND_SCRIPT,
        [BATTLE_KEYS.payload(battleId)],
        [
            String(questionIndex),
            String(BATTLE_TTL_SECONDS.ROUND_TIMEOUT),
            String(BATTLE_TTL_SECONDS.BATTLE_STATE)
        ]
    );
    if (["MISSING", "STALE"].includes(result[0])) return;
    if (result[0] === "CORRUPT") throw new Error(`Battle ${battleId} state is corrupted.`);
    const state = await getState(battleId);
    if (!state) return;

    if (result[0] === "OK") {
        emitBattlePlayers(state, BATTLE_EVENTS.ROUND_TIMEOUT, {
            battleId,
            question_index: questionIndex,
            unanswered: JSON.parse(result[1])
        });
    } else if (result[0] !== "RESOLVED") {
        throw new Error(`Unexpected round-timeout result: ${result[0]}`);
    }
    await scheduleNextQuestion(
        battleId,
        questionIndex,
        result[0] === "RESOLVED"
            ? BATTLE_TTL_SECONDS.ROUND_TURN_DELAY * 1000
            : 0
    );
};

export const submitBotAnswer = async ({ battleId, questionIndex } = {}) => {
    if (typeof battleId !== "string" || !Number.isInteger(questionIndex)) {
        throw new TypeError("Bot-answer job payload is invalid.");
    }
    const state = await getState(battleId);
    if (!state?.isBot || state.current_index !== questionIndex || state.phase !== "active") return;
    const botUserId = state.botuserid;
    const question = state.questions[questionIndex];
    const validOptions = BATTLE_ANSWER_KEYS.slice(0, question?.options?.length || 0);
    if (validOptions.length !== BATTLE_ANSWER_KEYS.length) {
        throw new Error(`Bot question ${questionIndex} does not have four valid options.`);
    }
    const shouldAnswerCorrectly =
        state.bot_correct_question_indexes?.includes(questionIndex) === true;
    const wrongAnswers = validOptions.filter((option) => option !== question.answer);
    if (!shouldAnswerCorrectly && !wrongAnswers.length) {
        throw new Error(`Bot question ${questionIndex} has no incorrect option.`);
    }
    const answer = shouldAnswerCorrectly
        ? question.answer
        : wrongAnswers[randomInt(wrongAnswers.length)];

    let result;
    try {
        result = await recordBattleAnswer({
            battleId,
            userId: botUserId,
            questionIndex,
            answer
        });
    } catch (error) {
        if (error.statusCode === 409 || error.statusCode === 404) return;
        throw error;
    }
    if (result.answeredCount === result.playerCount) {
        await scheduleNextQuestion(
            battleId,
            questionIndex,
            BATTLE_TTL_SECONDS.ROUND_TURN_DELAY * 1000
        );
    }
    emitBattlePlayers(state, BATTLE_EVENTS.PLAYER_ANSWERED, (playerId) => ({
        userId: botUserId,
        question_index: questionIndex,
        correct: playerId !== botUserId ? result.correct : undefined
    }));
};
</file>

<file path="src/workers/handlers/battle/socketEmitter.js">
import { Emitter } from "@socket.io/redis-emitter";
import Redis from "ioredis";
import { dbConfig } from "../../../config/env.js";
import { AppLogger } from "../../../utils/logger.js";

const ADAPTER_KEY = "socket.io";
const NAMESPACE = "/battle";
let redisClient;
let battleEmitter;

export const createBattleEmitter = (client) =>
    new Emitter(client, { key: ADAPTER_KEY }).of(NAMESPACE);

export const initializeBattleEmitter = async () => {
    if (battleEmitter) return;

    const client = new Redis(dbConfig.redis.url, {
        connectionName: "khelba-battle-emitter",
        connectTimeout: 5000,
        maxRetriesPerRequest: null,
        retryStrategy: (times) => Math.min(times * 100, 2000)
    });
    client.on("error", (error) => {
        AppLogger.error("Battle worker Socket.IO emitter Redis error", error, {
            component: "battle-socket-emitter"
        });
    });

    let timeout;
    try {
        await Promise.race([
            client.ping(),
            new Promise((_, reject) => {
                timeout = setTimeout(
                    () => reject(new Error("Battle worker Socket.IO emitter readiness timed out.")),
                    10000
                );
            })
        ]);
        redisClient = client;
        battleEmitter = createBattleEmitter(client);
    } catch (error) {
        client.disconnect();
        throw error;
    } finally {
        clearTimeout(timeout);
    }
};

export const emitBattleRoomEvent = (roomId, eventName, payload) => {
    if (!battleEmitter) {
        throw new Error("Battle worker Socket.IO emitter is not initialized.");
    }
    if (typeof roomId !== "string" || roomId.length === 0) {
        throw new TypeError("A battle room ID is required.");
    }
    if (typeof eventName !== "string" || eventName.length === 0) {
        throw new TypeError("A battle event name is required.");
    }

    return battleEmitter.to(roomId).emit(eventName, payload);
};

export const emitBattlePlayers = (state, eventName, payload) => {
    if (!state || !Array.isArray(state.players)) {
        throw new TypeError("Battle player list is missing.");
    }

    const recipients = state.players.filter((userId) =>
        !state.isBot || userId !== state.botuserid
    );
    for (const userId of recipients) {
        const recipientPayload = typeof payload === "function"
            ? payload(userId)
            : payload;
        emitBattleRoomEvent(userId, eventName, recipientPayload);
    }
};

export const closeBattleEmitter = async () => {
    const client = redisClient;
    redisClient = undefined;
    battleEmitter = undefined;
    if (client) await client.quit();
};
</file>

<file path="src/workers/handlers/battle/terminal.handler.js">
import mongoose from "mongoose";
import { redis } from "../../../config/redis.js";
import { mainQueue } from "../../../queues/main.queue.js";
import { AppLogger } from "../../../utils/logger.js";
import { BattleHistory } from "../../../models/battleHistory.model.js";
import { BattleReport } from "../../../models/battleReport.model.js";
import { compressBotReport } from "./bot-report.js";
import {
    BATTLE_BOT_POOL_KEY,
    BATTLE_EVENTS,
    BATTLE_FORFEIT,
    BATTLE_TTL_SECONDS,
    BATTLE_TIMEZONE
} from "../../../modules/battle/battle.constants.js";
import {
    BATTLE_KEYS,
    FINALIZE_BATTLE_CLEANUP_SCRIPT,
    FORFEIT_BATTLE_SCRIPT,
    redisCall
} from "../../../modules/battle/battle.redis.js";
import { calculateBattleResult } from "../../../modules/battle/battle.scoring.js";
import { scheduleBattleFinalization } from "../../../modules/battle/battle.jobs.js";
import { emitBattlePlayers } from "./socketEmitter.js";
import { calculateStreak } from "../../../utils/streak.js";

const updateReport = async ({ userId, result, date, isBot }, session) => {
    let report = await BattleReport.findOne({ user_id: userId }).session(session);
    if (!report) report = new BattleReport({ user_id: userId });
    if (!report.battle_count) report.battle_count = {};
    for (const count of ["total", "draw", "losses", "win"]) {
        report.battle_count[count] = Number.isFinite(Number(report.battle_count[count]))
            ? Number(report.battle_count[count])
            : 0;
    }
    if (!report.streak) {
        report.streak = {
            currentStreak: 0,
            longest_streak: 0,
            lastMatchDate: null,
            timezone: BATTLE_TIMEZONE
        };
    }
    if (!report.performance) report.performance = {};
    for (const metric of [
        "answered_questions",
        "correct_answers",
        "wrong_answers",
        "timed_out_answers",
        "total_answer_time",
        "accuracy"
    ]) {
        if (!Number.isFinite(Number(report.performance[metric]))) report.performance[metric] = 0;
    }

    report.battle_count.total += 1;
    report.battle_count[result.outcome === "win"
        ? "win"
        : result.outcome === "draw" ? "draw" : "losses"] += 1;
    const currentPoints = Number.isFinite(Number(report.battle_points))
        ? Number(report.battle_points)
        : 0;
    report.battle_points = Math.max(
        0,
        Math.round((currentPoints + result.matchPoints - (result.forfeitPenalty || 0)) * 100) / 100
    );
    const performance = report.performance;
    performance.answered_questions += result.answeredQuestions;
    performance.correct_answers += result.correctAnswers;
    performance.wrong_answers += result.wrongAnswers - result.timedOutAnswers;
    performance.timed_out_answers += result.timedOutAnswers;
    performance.total_answer_time = Math.round(
        (performance.total_answer_time + result.answerTimeUsed) * 100
    ) / 100;
    performance.accuracy = performance.answered_questions
        ? Math.round((performance.correct_answers / performance.answered_questions) * 10000) / 100
        : 0;
    Object.assign(report.streak, calculateStreak(report.streak, date, BATTLE_TIMEZONE));
    if (isBot) compressBotReport(report);
    await report.save({ session });
};

const persistBattle = async (state) => {
    const finalizedAt = new Date();
    const forcedWinner = state.isForfeit
        ? state.players.find((userId) => userId !== state.forfeitedUserId)
        : null;
    const result = calculateBattleResult(state, forcedWinner);
    if (state.isFriendBattle && result.winner !== "DRAW") {
        const hasZeroScore = state.players.some((userId) => Number(state.scores[userId]) === 0);
        if (hasZeroScore && result.playerResults[result.winner]) {
            result.playerResults[result.winner].matchPoints = Math.round(result.playerResults[result.winner].matchPoints / 2);
        }
    }
    if (state.isForfeit && result.playerResults[state.forfeitedUserId]) {
        result.playerResults[state.forfeitedUserId].forfeitPenalty = BATTLE_FORFEIT.POINT_PENALTY;
    }
    const document = {
        battleId: state.battleId,
        subject_code: state.subject_code,
        chapter: state.chapter,
        questions: state.questions,
        players: state.players,
        scores: result.scores,
        players_answers: state.players_answers,
        winner: result.winner,
        players_answers_durations: state.players_answered_durations,
        player_results: result.playerResults,
        botuserid: state.botuserid,
        isBot: state.isBot,
        isForfeit: state.isForfeit,
        forfeitedUserId: state.forfeitedUserId,
        finalizedAt
    };
    const session = await mongoose.startSession();
    let inserted = false;
    try {
        await session.withTransaction(async () => {
            const existing = await BattleHistory.findOne({ battleId: state.battleId })
                .session(session)
                .select("_id");
            if (existing) return;

            await BattleHistory.create([document], { session });
            for (const userId of state.players) {
                await updateReport({
                    userId,
                    result: result.playerResults[userId],
                    date: finalizedAt,
                    isBot: state.isBot && userId === state.botuserid
                }, session);
            }
            inserted = true;
        });
    } catch (error) {
        if (error?.code !== 11000) throw error;
        const existing = await BattleHistory.findOne({ battleId: state.battleId }).select("_id");
        if (!existing) throw error;
    } finally {
        await session.endSession();
    }

    return { result, inserted };
};

const removePendingJob = async (jobId) => {
    const job = await mainQueue.getJob(jobId);
    if (!job) return;
    if (["delayed", "waiting", "waiting-children"].includes(await job.getState())) {
        await job.remove();
    }
};

const cleanupBattleJobs = async (state) => {
    const jobs = [];
    for (let index = 0; index < state.total_questions; index += 1) {
        jobs.push(
            removePendingJob(`battle-timeout-${state.battleId}-${index}`),
            removePendingJob(`battle-bot-answer-${state.battleId}-${index}`)
        );
    }
    for (let index = 0; index <= state.total_questions; index += 1) {
        jobs.push(removePendingJob(`battle-next-${state.battleId}-${index}`));
    }
    for (const userId of state.players) {
        jobs.push(removePendingJob(`battle-forfeit-${state.battleId}-${userId}`));
    }
    await Promise.all(jobs);
};

export const forfeitBattle = async ({
    battleId,
    forfeitedUserId,
    expectedSocketId,
    isVoluntary = false
} = {}) => {
    if (typeof battleId !== "string" || typeof forfeitedUserId !== "string") {
        throw new TypeError("Forfeit job payload is invalid.");
    }
    const result = await redisCall(
        FORFEIT_BATTLE_SCRIPT,
        [
            BATTLE_KEYS.payload(battleId),
            BATTLE_KEYS.socket(forfeitedUserId),
            BATTLE_KEYS.socketLock(forfeitedUserId),
            BATTLE_KEYS.forfeitCount(forfeitedUserId),
            BATTLE_KEYS.forfeitBlocked(forfeitedUserId)
        ],
        [
            forfeitedUserId,
            expectedSocketId || "",
            isVoluntary ? "1" : "0",
            String(BATTLE_TTL_SECONDS.BATTLE_STATE),
            String(BATTLE_FORFEIT.WINDOW_SECONDS),
            String(BATTLE_FORFEIT.LIMIT),
            String(BATTLE_FORFEIT.RESTRICTION_SECONDS)
        ]
    );
    if (["MISSING", "RECONNECTED", "NOT_PLAYER", "NOT_ACTIVE"].includes(result[0])) return;
    if (result[0] === "CORRUPT") throw new Error(`Battle ${battleId} state is corrupted.`);

    const state = result[0] === "OK"
        ? JSON.parse(result[1])
        : result[0] === "DONE"
            ? JSON.parse(await redis.get(BATTLE_KEYS.payload(battleId)) || "null")
            : null;
    if (!state || state.phase !== "finalizing") return;
    emitBattlePlayers(state, BATTLE_EVENTS.FORFEITING_BATTLE, {
        battleId,
        forfeitedUserId
    });
    await scheduleBattleFinalization(battleId);
};

export const finalizeBattle = async ({ battleId } = {}) => {
    if (typeof battleId !== "string") throw new TypeError("Finalization job payload is invalid.");
    const raw = await redis.get(BATTLE_KEYS.payload(battleId));
    if (!raw) return;

    let state;
    try {
        state = JSON.parse(raw);
    } catch (error) {
        AppLogger.error("Battle finalization found corrupt state", error, {
            component: "battle-finalization",
            battleId
        });
        throw error;
    }
    if (state.phase !== "finalizing" && state.phase !== "finalized") return;

    const { result, inserted } = await persistBattle(state);
    await cleanupBattleJobs(state);
    const cleanup = await redisCall(
        FINALIZE_BATTLE_CLEANUP_SCRIPT,
        [
            BATTLE_KEYS.payload(battleId),
            ...state.players.map((userId) => BATTLE_KEYS.inBattle(userId)),
            ...state.players.map((userId) => BATTLE_KEYS.forfeitJob(userId)),
            BATTLE_BOT_POOL_KEY,
            BATTLE_KEYS.chat(battleId),
            BATTLE_KEYS.botChatState(battleId),
            BATTLE_KEYS.botChatPending(battleId),
            BATTLE_KEYS.botChatTurns(battleId)
        ],
        [
            battleId,
            String(BATTLE_TTL_SECONDS.BATTLE_STATE),
            `battle-forfeit-${battleId}-`
        ]
    );
    if (cleanup[0] !== "OK") {
        throw new Error(`Battle ${battleId} could not be cleaned after persistence.`);
    }

    if (state.isBot && state.botuserid) {
        emitBattlePlayers(state, BATTLE_EVENTS.DISPLAY_TYPING, {
            userId: state.botuserid,
            isTyping: false
        });
    }
    emitBattlePlayers(state, BATTLE_EVENTS.FINALIZE_BATTLE, {
        battleId,
        winner: result.winner,
        scores: result.scores,
        playerResults: result.playerResults,
        isForfeit: state.isForfeit
    });
    AppLogger.info("Battle finalized and persisted", {
        component: "battle-finalization",
        battleId,
        inserted
    });
};
</file>

