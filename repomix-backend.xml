<file path="src/services/cache.service.js">
import { redis } from "../config/redis.js";
import { AppLogger } from "../utils/logger.js";

export const CacheService = {
  async get(key) {
    try {
      const data = await redis.get(key);
      if (!data) return null;
      return data;
    } catch (error) {
      AppLogger.error(`Cache read operation failed for key: ${key}`, error);
      throw error;
    }
  },

  async getDel(key) {
    try {
      return await redis.getdel(key);
    } catch (error) {
      AppLogger.error(`Cache read-and-delete operation failed for key: ${key}`, error);
      throw error;
    }
  },

  async set(key, value, ttlInSeconds) {
    if (!Number.isSafeInteger(ttlInSeconds) || ttlInSeconds <= 0) {
      const error = new Error(`Cache injection rejected: Valid positive TTL duration is required. Found: ${ttlInSeconds}`);
      AppLogger.error("Cache argument boundary violation detected", error, { key });
      throw error;
    }
    try {
      const stringifiedValue = typeof value === "object" ? JSON.stringify(value) : String(value);
      await redis.set(key, stringifiedValue, "EX", ttlInSeconds);
      return true;
    } catch (error) {
      AppLogger.error(`Cache write operation failed for key: ${key}`, error);
      throw error;
    }
  },

  async setIfAbsent(key, value, ttlInSeconds) {
    if (!Number.isSafeInteger(ttlInSeconds) || ttlInSeconds <= 0) {
      throw new Error(`Cache injection rejected: Valid positive TTL duration is required. Found: ${ttlInSeconds}`);
    }
    try {
      const stringifiedValue = typeof value === "object" ? JSON.stringify(value) : String(value);
      return (await redis.set(key, stringifiedValue, "EX", ttlInSeconds, "NX")) === "OK";
    } catch (error) {
      AppLogger.error(`Conditional cache write failed for key: ${key}`, error);
      throw error;
    }
  },

  async del(key) {
    try {
      const result = await redis.del(key);
      return result > 0;
    } catch (error) {
      AppLogger.error(`Cache eviction failed for key: ${key}`, error);
      throw error;
    }
  },

  async exists(key) {
    try {
      const result = await redis.exists(key);
      return result === 1;
    } catch (error) {
      AppLogger.error(`Cache existence check failed for key: ${key}`, error);
      throw error;
    }
  },

  async increment(key) {
    try {
      return await redis.incr(key);
    } catch (error) {
      AppLogger.error(`Cache atomic increment execution failed for key: ${key}`, error);
      throw error;
    }
  },

  async getTTL(key) {
    try {
      const ttl = await redis.ttl(key);

      if (ttl === -2 || ttl === -1) {
        return null;
      }

      return ttl; 
    } catch (error) {
      AppLogger.error(`Cache TTL extraction failed for key: ${key}`, error);
      throw error;
    }
  }
};
</file>

<file path="src/services/streak.service.js">
import { BattleReport } from "../models/battleReport.model.js";
import { BATTLE_TIMEZONE } from "../modules/battle/battle.constants.js";
import { calculateStreak } from "../utils/streak.js";

const MAX_STREAK_UPDATE_ATTEMPTS = 8;

export const StreakService = {
    async recordActivity(userId, activityDate = new Date()) {
        try {
            await BattleReport.updateOne(
                { user_id: userId },
                { $setOnInsert: { user_id: userId } },
                { upsert: true }
            );
        } catch (error) {
            if (error?.code !== 11000 || !await BattleReport.exists({ user_id: userId })) {
                throw error;
            }
        }

        for (let attempt = 0; attempt < MAX_STREAK_UPDATE_ATTEMPTS; attempt += 1) {
            const report = await BattleReport.findOne({ user_id: userId })
                .select("streak")
                .lean();
            if (!report) throw new Error("Could not load the activity streak report.");

            const previous = report.streak || {};
            const next = calculateStreak(previous, activityDate, BATTLE_TIMEZONE);
            const previousCurrentStreak = Number(previous.currentStreak);
            const result = await BattleReport.updateOne(
                {
                    user_id: userId,
                    "streak.lastMatchDate": previous.lastMatchDate ?? null,
                    "streak.currentStreak": Number.isFinite(previousCurrentStreak)
                        ? previousCurrentStreak
                        : { $exists: false }
                },
                {
                    $set: {
                        "streak.currentStreak": next.currentStreak,
                        "streak.longest_streak": next.longest_streak,
                        "streak.lastMatchDate": next.lastMatchDate,
                        "streak.timezone": next.timezone
                    }
                }
            );
            if (result.matchedCount === 1) return next;
        }

        throw new Error("Could not record activity streak after concurrent update retries.");
    }
};
