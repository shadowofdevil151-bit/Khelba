export const BATTLE_CHAT_SCRIPT = `
local raw = redis.call('GET', KEYS[1])
if not raw then return {'MISSING'} end
local ok, state = pcall(cjson.decode, raw)
if not ok or type(state) ~= 'table' then return {'CORRUPT'} end
