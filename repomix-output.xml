        </section> : <>
            <section aria-label="বিভাগ বেছে নিন" className="mb-6 grid grid-cols-3 gap-2 rounded-2xl border border-white/10 bg-white/[.025] p-2 sm:mb-8 sm:gap-3 sm:p-3">
                {noteStreams.map(({ id, name }) => {
