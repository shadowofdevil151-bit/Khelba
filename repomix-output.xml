import { randomInt, randomUUID } from "node:crypto";
import { redis } from "../../config/redis.js";
import { mainQueue } from "../../queues/main.queue.js";
import { BATTLE_BOT_CHAT, BATTLE_JOBS, BATTLE_TTL_SECONDS } from "./battle.constants.js";
import { BATTLE_KEYS, CLAIM_BOT_CHAT_MILESTONE_SCRIPT, redisCall } from "./battle.redis.js";

const addBattleJob = (name, jobId, data, delay = 0) =>
    mainQueue.add(name, data, {
        jobId,
        delay,
        attempts: 3,
        backoff: { type: "exponential", delay: 1000 },
        removeOnComplete: true
    });

export const scheduleNextQuestion = (battleId, expectedIndex, delay = 0) =>
    addBattleJob(
        BATTLE_JOBS.NEXT_QUESTION,
        `battle-next-${battleId}-${expectedIndex + 1}`,
        { battleId, expectedIndex },
        delay
    );

export const scheduleRoundTimeout = (battleId, questionIndex, delay) =>
    addBattleJob(
        BATTLE_JOBS.ROUND_TIMEOUT,
        `battle-timeout-${battleId}-${questionIndex}`,
        { battleId, questionIndex },
        delay
    );

export const scheduleBotAnswer = (battleId, questionIndex, delay) =>
    addBattleJob(
        BATTLE_JOBS.BOT_SUBMIT_ANSWER,
        `battle-bot-answer-${battleId}-${questionIndex}`,
        { battleId, questionIndex },
        delay
    );

export const scheduleBotChatReply = (battleId, botUserId, humanUserId, message, delay) =>
    addBattleJob(
        BATTLE_JOBS.BOT_CHAT,
        `battle-bot-chat-${battleId}-${randomUUID()}`,
        { battleId, botUserId, humanUserId, message, proactive: false },
        delay
    );

export const scheduleBotProactiveChat = async (battleId, milestone, category, roundIndex) => {
    const chanceKey = category === "round_result" ? "round-result" : category;
    const chance = BATTLE_BOT_CHAT.PROACTIVE_CHANCES_PERCENT[chanceKey]
        ?? BATTLE_BOT_CHAT.PROACTIVE_CHANCES_PERCENT[milestone];
    if (chance === undefined) {
        throw new TypeError(`Unsupported bot-chat milestone: ${milestone}`);
    }
    const key = BATTLE_KEYS.botChatState(battleId);
    const claimed = await redisCall(
        CLAIM_BOT_CHAT_MILESTONE_SCRIPT,
        [key],
        [`milestone:${milestone}`, String(BATTLE_TTL_SECONDS.BATTLE_STATE)]
    );
    if (!claimed) return null;
    if (randomInt(0, 100) >= chance) return null;

    try {
        const delay = randomInt(
            BATTLE_BOT_CHAT.PROACTIVE_MIN_DELAY_MS,
            BATTLE_BOT_CHAT.PROACTIVE_MAX_DELAY_MS + 1
        );
        return await addBattleJob(
            BATTLE_JOBS.BOT_CHAT,
            `battle-bot-chat-${battleId}-${milestone}`,
            { battleId, milestone, category, roundIndex, proactive: true },
            delay
        );
    } catch (error) {
        await redis.srem(key, `milestone:${milestone}`);
        throw error;
    }
};

export const scheduleBotChatSend = (battleId, botUserId, humanUserId, text, delay, lockToken) =>
    addBattleJob(
        BATTLE_JOBS.BOT_CHAT_SEND,
        `battle-bot-chat-send-${battleId}-${randomUUID()}`,
        { battleId, botUserId, humanUserId, text, lockToken },
        delay
    );

export const scheduleBattleForfeit = (battleId, userId, socketId, delay) =>
    addBattleJob(
        BATTLE_JOBS.FORFEIT_BATTLE,
        `battle-forfeit-${battleId}-${userId}`,
        { battleId, forfeitedUserId: userId, expectedSocketId: socketId, isVoluntary: delay === 0 },
        delay
    );

export const scheduleBattleFinalization = (battleId) =>
    addBattleJob(
        BATTLE_JOBS.FINALIZE_BATTLE,
        `battle-finalize-${battleId}`,
        { battleId }
    );
</file>

<file path="src/modules/battle/battle.matchmaking-cancel.js">
import { mainQueue } from "../../queues/main.queue.js";
import { AppLogger } from "../../utils/logger.js";
import { BATTLE_BOT_POOL_KEY, BATTLE_TTL_SECONDS } from "./battle.constants.js";
import { BATTLE_KEYS, CANCEL_MATCHMAKING_SCRIPT, redisCall } from "./battle.redis.js";

const removeJob = async (jobId) => {
    const job = await mainQueue.getJob(jobId);
    if (!job) return;

    const state = await job.getState();
    if (state === "delayed" || state === "waiting" || state === "waiting-children") {
        await job.remove();
    }
};

const removeJobs = async (jobIds, userId, requestId) => {
    await Promise.all(jobIds.filter(Boolean).map(async (jobId) => {
        try {
            await removeJob(jobId);
        } catch (error) {
            AppLogger.error("Could not remove a cancelled matchmaking job", error, {
                component: "battle-matchmaking",
                userId,
                requestId,
                jobId
            });
        }
    }));
};

export async function cancelMatchmaking(userId, requestId, retryStale = true) {
    const result = await redisCall(
        CANCEL_MATCHMAKING_SCRIPT,
        [
            BATTLE_KEYS.waiting(userId),
            BATTLE_KEYS.inBattle(userId),
            BATTLE_KEYS.noOpponentJob(userId),
            BATTLE_KEYS.matchupWithBotJob(userId),
            BATTLE_KEYS.cancelRequest(userId, requestId),
            BATTLE_KEYS.searchRequest(userId),
            BATTLE_KEYS.matchRequest(userId),
            BATTLE_KEYS.matchOpponent(userId),
            BATTLE_KEYS.matchIsBot(userId),
            BATTLE_BOT_POOL_KEY
        ],
        [userId, requestId, String(BATTLE_TTL_SECONDS.MATCHMAKING_CANCEL)]
    );
    const [status, ...details] = result;

    if (status === "MATCHED") {
        return { status, battleId: details[0] };
    }
    if (status === "MATCH_CANCELLED") {
        const [battleId, opponentId, opponentRequestId, isBot] = details;
        await removeJobs([`battle-next-${battleId}-0`], userId, requestId);
        return {
            status,
            battleId,
            opponentId,
            opponentRequestId,
            isBot: isBot === "1"
        };
    }
    if (status === "STALE") {
        const activeRequestId = details[0];
        if (
            retryStale &&
            activeRequestId &&
            activeRequestId !== requestId
        ) {
            return cancelMatchmaking(userId, activeRequestId, false);
        }
        return { status, activeRequestId };
    }
    if (status !== "CANCELLED" && status !== "IDLE") {
        throw new Error(`Unexpected matchmaking cancellation result: ${status}`);
    }

    await removeJobs(details, userId, requestId);
    return { status };
}
</file>

<file path="src/modules/battle/battle.questions.js">
import { Mcq } from "../../models/mcq.model.js";
import { ApiError } from "../../utils/ApiError.js";
import { BATTLE_ANSWER_KEYS, BATTLE_QUESTION_COUNT } from "./battle.constants.js";

export const getBattleQuestions = async (subjectCode, chapter) => {
    const questions = await Mcq.aggregate([
        {
            $match: {
                subject_code: subjectCode,
                chapter,
                // "verification.status": "verified", // TODO: Enable this once we have a verified questions collection
                options: { $size: 4 },
                answer: { $in: BATTLE_ANSWER_KEYS }
            }
        },
        { $sample: { size: BATTLE_QUESTION_COUNT } },
        {
            $project: {
                board: 1,
                college: 1,
                year: 1,
                question_number: 1,
                context: 1,
                question: 1,
                options: 1,
                sub_statements: 1,
                sub_question: 1,
                has_image: 1,
                image: 1,
                answer: 1
            }
        }
    ]);

    if (questions.length !== BATTLE_QUESTION_COUNT) {
        throw new ApiError(409, "Not enough verified questions are available for this battle.");
    }
    return questions;
};

export const sanitizeQuestion = (question) => ({
    id: question._id.toString(),
    question_number: question.question_number,
    context: question.context,
    question: question.question,
    options: question.options,
    sub_statements: question.sub_statements,
    sub_question: question.sub_question,
    has_image: question.has_image,
    image: question.image
});
