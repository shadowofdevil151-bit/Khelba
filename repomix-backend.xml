import mongoose from "mongoose";
import { jwtDecrypt } from "jose";
import { ApiError } from "../../utils/ApiError.js";
import { CacheService } from "../../services/cache.service.js";
import { CACHE_KEYS } from "../../constants/cache.constants.js";
import { securityConfig } from "../../config/env.js";
import { User } from "../../models/user.model.js";
import { Session } from "../../models/session.model.js";

export const authenticateAccessToken = async (accessToken) => {
    if (typeof accessToken !== "string" || accessToken.length === 0) {
        throw new ApiError(401, "Authentication token is missing.").asWarn();
    }

    if (await CacheService.get(CACHE_KEYS.BLACKLIST_TOKEN(accessToken))) {
        throw new ApiError(401, "Session expired. Please log in again.").asWarn();
    }

    let payload;
    try {
        ({ payload } = await jwtDecrypt(accessToken, securityConfig.tokens.accessTokenSecret));
    } catch (error) {
        const message = error.code === "ERR_JWT_EXPIRED" || error.message?.includes("expired")
            ? "Access token has expired."
            : "Access token is invalid.";
        throw new ApiError(401, message).asWarn();
    }

    const { userId, sessionId, tokenVersion } = payload;
    if (
        typeof userId !== "string" ||
        !mongoose.isValidObjectId(userId) ||
        typeof sessionId !== "string" ||
        !mongoose.isValidObjectId(sessionId) ||
        !Number.isSafeInteger(tokenVersion)
    ) {
        throw new ApiError(401, "Access token is invalid.").asWarn();
    }

    const [user, session] = await Promise.all([
        User.findById(userId).select("_id username avatar role tier tokenVersion status"),
        Session.findOne({
            _id: sessionId,
            user: userId,
            isValid: true,
            expiresAt: { $gt: new Date() }
        }).select("_id")
    ]);

    if (!user || user.status !== "ACTIVE" || user.tokenVersion !== tokenVersion || !session) {
        throw new ApiError(401, "Session has expired or been revoked.").asWarn();
    }

    return {
        token: accessToken,
        user: {
            _id: user._id.toString(),
            username: user.username,
            avatar_url: user.avatar?.url || null,
            role: user.role,
            tier: user.tier,
            tokenVersion: user.tokenVersion
        }
    };
};
</file>

<file path="src/modules/battle/battle.answers.js">
import { ApiError } from "../../utils/ApiError.js";
import { BATTLE_TTL_SECONDS } from "./battle.constants.js";
import { BATTLE_KEYS, SUBMIT_BATTLE_ANSWER_SCRIPT, redisCall } from "./battle.redis.js";

const ERROR_MESSAGES = Object.freeze({
    MISSING: [404, "Battle is no longer available."],
    CORRUPT: [500, "Battle state is corrupted."],
    NOT_ACTIVE: [409, "Battle is not accepting answers."],
    STALE: [409, "That question is no longer active."],
    NOT_PLAYER: [403, "You are not a participant in this battle."],
    BAD_QUESTION: [500, "Battle question state is invalid."],
    BAD_ANSWER: [400, "Answer is not a valid option."],
    TIME_EXPIRED: [409, "The time to answer this question has expired."],
    DUPLICATE: [409, "You have already answered this question."]
});

export const recordBattleAnswer = async ({ battleId, userId, questionIndex, answer }) => {
    const result = await redisCall(
        SUBMIT_BATTLE_ANSWER_SCRIPT,
        [BATTLE_KEYS.payload(battleId)],
        [
            userId,
            String(questionIndex),
            answer,
            String(BATTLE_TTL_SECONDS.ROUND_TIMEOUT),
            String(BATTLE_TTL_SECONDS.BATTLE_STATE)
        ]
    );

    if (result[0] !== "OK" && result[0] !== "DUPLICATE") {
        const [statusCode, message] = ERROR_MESSAGES[result[0]] || [500, "Answer submission failed."];
        throw new ApiError(statusCode, message);
    }

    return {
        answeredCount: Number(result[1]),
        playerCount: Number(result[2]),
        correct: result[3] === "1",
        correctAnswer: result[4],
        duplicate: result[0] === "DUPLICATE"
    };
};
</file>

