<file path="frontend/contexts/AuthProvider.jsx">
"use client";
import { createContext, useCallback, useEffect, useRef, useState } from "react";
import { api, authApi, tokenStore, API_ORIGIN } from "@/lib/api";

export const AuthContext = createContext(null);
const normalizeUser = (account) => account
    ? { ...account, _id: account._id || account.id }
    : null;

export function AuthProvider({ children }) {
    const [user, setUser] = useState(null);
    const [ready, setReady] = useState(false);
    const [authUnavailable, setAuthUnavailable] = useState(false);
    const refreshRef = useRef(null);
    const restoreSession = useCallback(async () => {
        if (refreshRef.current) return refreshRef.current;
        setReady(false);
        setAuthUnavailable(false);
        const run = (async () => {
            try {
                const session = await authApi.refresh();
                setUser(normalizeUser(session.user));
                tokenStore.set(session.accessToken);
                setAuthUnavailable(false);
            } catch (error) {
                tokenStore.clear();
                setUser(null);
                if (error.status === 409) {
                    await new Promise((resolve) => setTimeout(resolve, 120));
                    try {
                        const retry = await authApi.refresh();
                        setUser(normalizeUser(retry.user));
                        tokenStore.set(retry.accessToken);
                        setAuthUnavailable(false);
                        return;
                    } catch (retryError) {
                        setAuthUnavailable(retryError.status === 429 || !retryError.status || retryError.status >= 500);
                        return;
                    }
                }
                setAuthUnavailable(error.status === 429 || !error.status || error.status >= 500);
            } finally {
                setReady(true);
            }
        })();
        refreshRef.current = run.finally(() => { refreshRef.current = null; });
        return refreshRef.current;
    }, []);
    useEffect(() => {
        restoreSession();
    }, [restoreSession]);
    const login = async (credentials) => {
        const body = await authApi.login(credentials);
        tokenStore.set(body.data.accessToken);
        setUser(normalizeUser(body.data.userProfile));
        setAuthUnavailable(false);
        const next = new URLSearchParams(window.location.search).get("next");
        if (next) sessionStorage.setItem("auth:next", next);
        return body.data;
    };
    const logout = async () => { await api("/auth/logout", { method: "POST" }).catch(() => { }); tokenStore.clear(); setUser(null); };
    const googleLogin = () => { window.location.href = `${API_ORIGIN}/api/v1/auth/google`; };
    return <AuthContext.Provider value={{ user, setUser, ready, authUnavailable, retryAuth: restoreSession, login, logout, googleLogin }}>{children}</AuthContext.Provider>;
}
</file>

<file path="frontend/contexts/NotificationProvider.jsx">
"use client";

import { createContext, useCallback, useEffect, useMemo, useState } from "react";
import { api } from "@/lib/api";
import { connectSocket } from "@/lib/socket";
import { useAuth } from "@/hooks/useAuth";

export const NotificationContext = createContext(null);

function uniqueById(items) {
    const seen = new Set();
    return (Array.isArray(items) ? items : []).filter((item) => {
        const id = String(item?._id || "");
        if (!id || seen.has(id)) return false;
        seen.add(id);
        return true;
    });
}

function mergeNotification(current, item) {
    if (!item) return current;
    const newActor = String(item.actor || item.payload?.senderId || "");
    const base = item.type === "friend_battle_request" && newActor
        ? current.filter((existing) => existing.type !== item.type
            || String(existing.actor || existing.payload?.senderId || "") !== newActor)
        : current;
    return uniqueById([item, ...base]);
}

export function NotificationProvider({ children }) {
    const { user, ready } = useAuth();
    const [items, setItems] = useState([]);
    const [connected, setConnected] = useState(false);

    useEffect(() => {
        if (!ready || !user?._id) {
            setItems([]);
            setConnected(false);
            return undefined;
        }
        const socket = connectSocket("/notifications");
        const onConnect = () => setConnected(true);
        const onDisconnect = () => setConnected(false);
        const onSnapshot = (snapshot) => {
            const ordered = Array.isArray(snapshot) ? [...snapshot].reverse() : [];
            setItems(ordered.reduce((current, item) => mergeNotification(current, item), []));
        };
        const onNew = (item) => setItems((current) => mergeNotification(current, item));
        const onDeleted = (id) => setItems((current) => current.filter((item) => String(item._id) !== String(id)));
        socket.on("connect", onConnect);
        socket.on("disconnect", onDisconnect);
        socket.on("notification:snapshot", onSnapshot);
        socket.on("notification:new", onNew);
        socket.on("notification:deleted", onDeleted);
        socket.on("connect_error", onDisconnect);
        return () => {
            socket.off("connect", onConnect);
            socket.off("disconnect", onDisconnect);
            socket.off("notification:snapshot", onSnapshot);
            socket.off("notification:new", onNew);
            socket.off("notification:deleted", onDeleted);
            socket.off("connect_error", onDisconnect);
            socket.disconnect();
        };
    }, [ready, user?._id]);

    const markSeen = useCallback(async (ids) => {
        const selected = Array.isArray(ids) ? ids.map(String) : [];
        try {
            await api("/notifications/seen", {
                method: "POST",
                body: JSON.stringify({ ids: selected.length ? selected : undefined })
            });
            setItems((current) => current.map((item) =>
                !selected.length || selected.includes(String(item._id))
                    ? { ...item, seen: true, seenAt: new Date().toISOString() }
                    : item
            ));
        } catch (error) {
            throw error;
        }
    }, []);

    const clearChatNotification = useCallback((senderId) => {
        setItems((current) => current.filter((item) =>
            !(item.type === "friend_chat"
                && String(item.actor || item.payload?.senderId) === String(senderId))
        ));
    }, []);

    const unseenCount = useMemo(() => items.reduce((total, item) => total + (item.seen ? 0 : 1), 0), [items]);
    const value = useMemo(() => ({
        items,
        unseenCount,
        connected,
        markSeen,
        clearChatNotification
    }), [items, unseenCount, connected, markSeen, clearChatNotification]);

    return <NotificationContext.Provider value={value}>{children}</NotificationContext.Provider>;
}
</file>

